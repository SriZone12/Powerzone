# Copy this file to .env.local and fill in the real values.
# Both are required: the build fails without them (see lib/supabase.ts).
#
# Supabase Dashboard -> your project -> Settings -> API
#   Project URL      -> NEXT_PUBLIC_SUPABASE_URL
#   anon / public    -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# The anon key is safe to ship in a client bundle; security comes from Row Level
# Security, not from hiding this key. Never put the service_role key in here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
